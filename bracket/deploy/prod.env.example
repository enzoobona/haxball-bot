# Copiá este archivo a la raíz de "bracket" con el nombre ".env" y completalo.
# Generá los secretos con:   openssl rand -hex 32
# (usá solo letras y números en POSTGRES_PASSWORD: va dentro de una URL)

# Dominio SIN https:// (por ejemplo: mitorneo.duckdns.org)
DOMAIN=

# Clave para firmar las sesiones. Si la cambiás, se cierran todas las sesiones.
JWT_SECRET=

# Usuario administrador (se crea la primera vez que arranca con la base vacía).
ADMIN_EMAIL=
ADMIN_PASSWORD=

POSTGRES_PASSWORD=
