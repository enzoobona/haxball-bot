# Copiá este archivo como ".env" y completalo. NUNCA subas el .env a un repositorio.

# --- Haxball ---
# Token temporal: https://www.haxball.com/headlesstoken  (vence rápido: generalo justo antes de arrancar)
HAXBALL_TOKEN=

# --- Bracket ---
# Sin barra final. Local: http://localhost:8400/api   |   Producción: https://tu-dominio/api
BRACKET_API_URL=http://localhost:8400/api
BRACKET_USERNAME=admin@example.com
BRACKET_PASSWORD=
BRACKET_TOURNAMENT_ID=1

# --- Sala (todo opcional) ---
ROOM_NAME=Torneo Haxball
ROOM_PASSWORD=
ROOM_PUBLIC=false
ROOM_MAX_PLAYERS=16

# --- Administración ---
Con ADMIN_PASSWORD o ADMIN_AUTHS el primero que entra YA NO es admin automáticamente.
Los jugadores usan "!admin <clave>" (el mensaje no se muestra en el chat).
ADMIN_PASSWORD=
Auths de Haxball separados por coma (se ven en la consola del bot al entrar alguien).
ADMIN_AUTHS=

# --- Reglas del torneo ---
# Solo pueden jugar los inscriptos en el equipo del partido (poné false para amistosos).
ENFORCE_ROSTERS=true
# Segundos de cada período de muerte súbita en eliminación directa (si nadie marca, se repite).
OVERTIME_SECONDS=180

# --- Mantenimiento ---
REFRESH_MINUTES=5       # cada cuánto se relee jugadores/equipos desde Bracket
RETRY_SECONDS=60        # cada cuánto se reintentan resultados que no se pudieron enviar
SAVE_REPLAYS=true       # guarda un .hbr2 por partido en REPLAYS_DIR
DATA_DIR=data           # cola de resultados pendientes y vínculos nombre<->auth
REPLAYS_DIR=replays
